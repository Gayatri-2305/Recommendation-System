import pandas as pd
import numpy as np
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    mean_squared_error,
    mean_absolute_error,
    precision_score,
    recall_score,
    f1_score,
    accuracy_score,
    classification_report
)

data = {
    'User': [
        1,1,1,
        2,2,2,
        3,3,3,
        4,4,4,
        5,5,5
    ],

    'Item': [
        'Movie1','Movie2','Movie3',
        'Movie1','Movie2','Movie4',
        'Movie1','Movie3','Movie5',
        'Movie2','Movie4','Movie5',
        'Movie1','Movie4','Movie5'
    ],

    'Rating': [
        5,4,3,
        4,5,2,
        2,5,4,
        4,3,5,
        3,4,5
    ]
}

df = pd.DataFrame(data)

train_data, test_data = train_test_split(
    df,
    test_size=0.2,
    random_state=42
)

rating_matrix = train_data.pivot_table(
    index='User',
    columns='Item',
    values='Rating'
).fillna(0)

print("Rating Matrix:\n")
print(rating_matrix)

user_similarity = cosine_similarity(rating_matrix)

user_similarity_df = pd.DataFrame(
    user_similarity,
    index=rating_matrix.index,
    columns=rating_matrix.index
)

print("\nUser Similarity Matrix:\n")
print(user_similarity_df)

predicted_ratings = np.dot(
    user_similarity,
    rating_matrix
) / np.array([np.abs(user_similarity).sum(axis=1)]).T

predicted_ratings_df = pd.DataFrame(
    predicted_ratings,
    index=rating_matrix.index,
    columns=rating_matrix.columns
)

print("\nPredicted Ratings:\n")
print(predicted_ratings_df)

user_id = 1

recommended_items = predicted_ratings_df.loc[user_id].sort_values(
    ascending=False
)

print(f"\nRecommended Items for User {user_id}:\n")

for item, rating in recommended_items.items():
    print(f"{item} --> Predicted Rating: {rating:.2f}")

actual = []
predicted = []

for _, row in test_data.iterrows():

    user = row['User']
    item = row['Item']
    true_rating = row['Rating']

    if user in predicted_ratings_df.index and item in predicted_ratings_df.columns:

        pred_rating = predicted_ratings_df.loc[user, item]

        actual.append(true_rating)
        predicted.append(pred_rating)

rmse = np.sqrt(mean_squared_error(actual, predicted))
mae = mean_absolute_error(actual, predicted)

actual_class = [1 if x >= 3 else 0 for x in actual]
predicted_class = [1 if x >= 3 else 0 for x in predicted]

precision = precision_score(actual_class, predicted_class)
recall = recall_score(actual_class, predicted_class)
f1 = f1_score(actual_class, predicted_class)
accuracy = accuracy_score(actual_class, predicted_class)

print("\nEvaluation Metrics:\n")

print(f"RMSE      : {rmse:.2f}")
print(f"MAE       : {mae:.2f}")
print("\nClassification Report:\n")
print(classification_report(actual_class, predicted_class))
